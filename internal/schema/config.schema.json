{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ravenmk2/barista/master/internal/schema/config.schema.json",
  "title": "barista config.json",
  "description": "Workspace-level settings (<workspace>/.barista/config.json), entirely optional",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "parallel": {
      "type": "integer",
      "minimum": 1,
      "default": 10,
      "description": "Max concurrent repo operations; overridden by --parallel"
    },
    "color": {
      "type": "string",
      "enum": ["auto", "always", "never"],
      "default": "auto",
      "description": "Color output mode; NO_COLOR env var takes precedence over everything"
    }
  }
}
