{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ravenmk2/barista/master/schemas/manifest.schema.json",
  "title": "barista release manifest",
  "description": "Release manifest published as a GitHub release asset (manifest.json); consumed by barista upgrade",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "version", "assets"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Release tag (e.g. v0.4.0)"
    },
    "publishedAt": {
      "type": "string",
      "description": "ISO 8601 UTC timestamp"
    },
    "assets": {
      "type": "object",
      "minProperties": 1,
      "description": "Per-platform binary archives, keyed by <goos>/<goarch>",
      "patternProperties": {
        "^(windows|linux|darwin)/(amd64|arm64)$": {
          "type": "object",
          "additionalProperties": true,
          "required": ["file", "format", "entry", "sha256", "size"],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "description": "Asset file name in the same release"
            },
            "format": {
              "type": "string",
              "enum": ["zip", "tar.gz"],
              "description": "Archive format of the asset (windows uses zip, unix uses tar.gz)"
            },
            "entry": {
              "type": "string",
              "minLength": 1,
              "description": "Path of the barista binary inside the archive (barista or barista.exe); other entries are extras like LICENSE and completions"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$",
              "description": "SHA-256 of the archive file"
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "description": "Archive size in bytes"
            }
          }
        }
      }
    }
  }
}
