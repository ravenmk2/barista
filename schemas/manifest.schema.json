{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ravenmk2/barista/master/schemas/manifest.schema.json",
  "title": "barista release manifest",
  "description": "Release manifest published as a GitHub release asset (manifest.json); consumed by barista upgrade",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "version", "assets"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Release tag (e.g. v0.3.0)"
    },
    "publishedAt": {
      "type": "string",
      "description": "ISO 8601 UTC timestamp"
    },
    "assets": {
      "type": "object",
      "minProperties": 1,
      "description": "Per-platform binaries, keyed by <goos>/<goarch>",
      "patternProperties": {
        "^(windows|linux|darwin)/(amd64|arm64)$": {
          "type": "object",
          "additionalProperties": true,
          "required": ["file", "sha256", "size"],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "description": "Asset file name in the same release"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
